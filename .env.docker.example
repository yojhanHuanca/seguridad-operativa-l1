# Variables para `docker compose up`. Copiar a ".env" en esta misma carpeta
# (junto a docker-compose.yml) y completar. Docker Compose lo lee solo.
#
#   cp .env.docker.example .env

# Contraseña de la base Postgres que crea el propio compose (no la de Railway).
POSTGRES_PASSWORD=sigma_dev_password

# Cualquier cadena larga sirve en desarrollo; en producción es la de Railway.
JWT_SECRET=cambia-esto-por-algo-largo-y-aleatorio

# Opcionales: sin esto, el botón de Google, el envío de correos y las
# notificaciones push simplemente no funcionan, pero el resto sí.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
RESEND_API_KEY=
EMAIL_FROM=SMS L1 <onboarding@resend.dev>

# Ver backend/.env.example para cómo generar el par VAPID.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@lineauno.pe
VITE_VAPID_PUBLIC_KEY=
