# Copiar a .env.docker. No guardar credenciales reales en el repositorio.
# Para desarrollo local se puede generar con:
#   openssl rand -hex 32

POSTGRES_PASSWORD=replace-with-a-random-hex-password
JWT_SECRET=replace-with-a-different-random-secret
JWT_EXPIRES_IN=8h
TRUST_PROXY_HOPS=1

# Dirección usada para enlaces de correo y validación CORS.
FRONTEND_URL=http://localhost:8080
FRONTEND_PORT=8080

# Opcionales. El correo local se captura en Mailpit (http://localhost:8025).
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
RESEND_API_KEY=
EMAIL_FROM=SMS L1 <onboarding@resend.dev>

# Push requiere el mismo par de claves en backend y frontend, además de HTTPS
# en cualquier sitio que no sea localhost.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@lineauno.pe
VITE_VAPID_PUBLIC_KEY=
