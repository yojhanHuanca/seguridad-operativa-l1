VITE_API_URL=http://localhost:3000/api

# Client ID (tipo "Web application") de https://console.cloud.google.com/apis/credentials
# Si se deja vacío, el botón "Iniciar sesión con Google" simplemente no aparece.
VITE_GOOGLE_CLIENT_ID=

# Misma clave pública que VAPID_PUBLIC_KEY en backend/.env — no es secreta, se
# genera junto con su par privada (ver backend/.env.example). Si se deja
# vacío, el botón de activar notificaciones push simplemente no aparece.
VITE_VAPID_PUBLIC_KEY=
