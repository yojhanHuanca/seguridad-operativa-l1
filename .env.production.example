# Copiar a .env.production en el servidor y completar con TI.
# No versionar ni compartir este archivo completado.

# Usar una cadena hexadecimal generada por un gestor de secretos u openssl.
POSTGRES_PASSWORD=replace-with-a-random-hex-password
JWT_SECRET=replace-with-a-different-random-secret
JWT_EXPIRES_IN=8h
TRUST_PROXY_HOPS=1

# URL pública HTTPS del sitio y puerto publicado por el contenedor frontend.
FRONTEND_URL=https://sistema.empresa.example
FRONTEND_PORT=8080

# Correo transaccional usado por el sistema para asignaciones y solicitudes.
# Actualmente se implementa con Resend API; no está implementado envío Gmail.
RESEND_API_KEY=
EMAIL_FROM=Seguridad Operativa <notificaciones@empresa.example>

# Google OAuth: configurar el mismo Client ID en backend y frontend, y registrar
# el origen FRONTEND_URL en la consola de Google.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# Web Push: generar un par VAPID y usar la clave pública en ambos lados.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@empresa.example
VITE_VAPID_PUBLIC_KEY=
