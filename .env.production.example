# Variables para docker-compose.production.yml.
# Copiar este archivo a .env.production y completar los valores reales.
# No subir .env.production al repositorio.

# PostgreSQL administrado (Railway, RDS, etc.). El esquema debe existir antes
# de iniciar la aplicación; el Compose productivo no ejecuta db push.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public

# Secreto largo y aleatorio; nunca reutilizar el valor de desarrollo.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h

# URLs públicas, sin barra final.
FRONTEND_URL=https://app.example.com
VITE_API_URL=https://api.example.com/api

# Puertos publicados por Docker en el servidor.
BACKEND_PORT=3000
FRONTEND_PORT=8080

# Integraciones opcionales.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
RESEND_API_KEY=
EMAIL_FROM=SMS L1 <onboarding@resend.dev>
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@lineauno.pe
VITE_VAPID_PUBLIC_KEY=
