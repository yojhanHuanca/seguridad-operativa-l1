{
  "name": "backend",
  "version": "1.0.0",
  "description": "Backend del Sistema de Gestión de Seguridad Operativa - Línea 1 Metro de Lima",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "postinstall": "prisma generate",
    "build": "tsc",
    "postbuild": "node scripts/copy-prisma-engine.mjs",
    "start": "node dist/server.js",
    "seed": "tsx prisma/seed.ts",
    "seed:contingencias": "tsx prisma/seed-contingencias.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db:prepare": "node scripts/test-db.mjs",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:coverage": "vitest run --config vitest.combined.config.ts --coverage",
    "test:coverage:unit": "vitest run --coverage",
    "test:coverage:integration": "vitest run --config vitest.integration.config.ts --coverage"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "keywords": [
    "express",
    "typescript",
    "postgresql",
    "metro",
    "seguridad-operativa"
  ],
  "author": "Yojhan Huanca",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "google-auth-library": "^11.0.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "nodemailer": "^10.0.15",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "prisma": "^6.19.3",
    "resend": "^6.22.0",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    }
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.1",
    "@types/nodemailer": "^8.0.1",
    "@types/supertest": "^7.2.1",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^4.1.11",
    "supertest": "^7.3.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.2",
    "vitest": "^4.1.11"
  }
}
