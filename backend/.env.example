DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/bd_seguridad_metro?schema=public"

PORT=3000

JWT_SECRET=change-me-to-a-long-random-secret
TRUST_PROXY_HOPS=0

JWT_EXPIRES_IN=8h

# Client ID (tipo "Web application") de https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=

# API key de https://resend.com/api-keys — para el correo de "Olvidé mi contraseña"
RESEND_API_KEY=
EMAIL_FROM=SMS L1 <onboarding@resend.dev>

# Opcional, solo desarrollo: si se define, el correo sale por acá en vez de
# por Resend, sin depender de un dominio verificado. "ethereal" crea una
# bandeja de prueba al vuelo (sin registro, sin Docker) — cada envío queda
# registrado en la consola del backend con un link para verlo.
SMTP_HOST=ethereal
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
# Puerto 465 usa TLS desde el inicio; 587 usa STARTTLS para SMTP autenticado.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true,
# SMTP_USER=tu-correo@gmail.com y SMTP_PASS=contraseña de aplicación de Google.
# EMAIL_FROM debe usar el correo remitente autorizado de esa cuenta.
SMTP_SECURE=false

# Origen del frontend, para armar el link del correo de recuperación
FRONTEND_URL=http://localhost:5173

# Solo para el alta inicial con npm run setup:admin. Completar de forma privada
# y retirar INITIAL_ADMIN_PASSWORD después. No restablece cuentas existentes.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=Administrador

# Notificaciones push del navegador/celular. Generar un par nuevo con:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# La pública va también al frontend (VITE_VAPID_PUBLIC_KEY, mismo valor).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@lineauno.pe
